# --- env / secrets: dev-generated values only; .env.example is the only committed env file ---
.env
.env.*
!.env.example

# --- Go ---
backend/bin/
backend/dist/
*.test
*.out
coverage.*

# --- Frontend / Node ---
frontend/node_modules/
frontend/build/
frontend/.svelte-kit/
frontend/.vite/
npm-debug.log*

# --- Terraform (templates only; state is never committed) ---
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log

# --- misc ---
*.log
.DS_Store
