# Frontend build-time config (PUBLIC_ prefix => exposed to the browser bundle).
# Copy to .env for local `npm run dev` builds, or pass as docker build ARGs.
# All values are optional; the defaults below are what the dev stack uses.

# Base path of the backend API. In dev, vite proxies /api -> backend:8080.
PUBLIC_API_BASE=/api

# New Relic browser monitoring — leave both unset to disable the agent
# (the default for local dev; the agent no-ops on incomplete config).
# The browser app itself is identified by PUBLIC_NR_APPLICATION_ID.
PUBLIC_NR_LICENSE_KEY=
PUBLIC_NR_APPLICATION_ID=
